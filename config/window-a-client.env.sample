# DocumentViewer / Socket.IO クライアント設定
# ラズパイ 4 (Window A) を RaspberryPiServer へ接続する場合のサンプル

# RaspberryPiServer への REST / DocumentViewer 基本設定
RASPI_SERVER_BASE=http://raspi-server.local:8501
# RaspberryPiServer へ送信する API トークン（例はダミー値。Pi5 の `/etc/default/raspi-server` と一致させる）
RASPI_SERVER_API_TOKEN=raspi-token-20251027
# DocumentViewer iframe が参照する URL（未設定時は上記 BASE に `/viewer` を付与して自動解決）
DOCUMENT_VIEWER_URL=

# Socket.IO ブロードキャストの接続先
UPSTREAM_SOCKET_BASE=http://raspi-server.local:8501
UPSTREAM_SOCKET_PATH=/socket.io

# Socket.IO 自動接続フラグ（0 または false で無効化）
UPSTREAM_SOCKET_AUTO=1

# API トークン強制を無効化したい場合は 0 に設定（運用では既定の 1 を推奨）
# API_TOKEN_ENFORCE=1

# DocumentViewer が同一機体で動作する場合は DOCUMENT_VIEWER_URL をローカル参照に変更
# 例: DOCUMENT_VIEWER_URL=http://127.0.0.1:5000
