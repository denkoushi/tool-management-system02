# Window A Playwright E2E 用環境ファイル
# `.env.test` へコピーして値を書き換えてください。

# Window A (Pi4) クライアント UI へのアクセス URL
TOOLMGMT_BASE_URL=http://raspi-window-a.local:8501

# Window A の API トークン（Pi5 `/etc/default/raspi-server` と一致させる）
TOOLMGMT_API_TOKEN=raspi-token-20251026

# RaspberryPiServer (Pi5) API ベース URL
RASPI_SERVER_BASE=http://raspi-server.local:8501

# RaspberryPiServer の API トークン（`/etc/default/raspi-server:API_TOKEN` と同じ）
RASPI_SERVER_API_TOKEN=raspi-token-20251026

# DocumentViewer API トークン（必要に応じて設定。未使用ならコメントアウトのままで可）
# VIEWER_API_TOKEN=viewer-token-placeholder

# Playwright をヘッドレスで実行する場合は 1、ブラウザ表示したい場合は 0
PLAYWRIGHT_HEADLESS=1
